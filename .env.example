NODE_ENV=development
PORT=3000

# Set a long random value before deploying.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: share cookies between your own subdomains. Leave blank for localhost/onrender.com.
SESSION_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_RESPONSES_MODEL=gpt-6-luna
GOOGLE_CLIENT_ID=your-google-oauth-client-id
KAKAO_MAP_API_KEY=your-kakao-javascript-key
KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
KAKAO_REST_API_KEY=your-kakao-rest-key
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
